{
    "name": "eonx-com/quality-tools",
    "description": "Necessary quality tools for the project",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "eonx-com/easy-quality": "^6.5",
        "phpunit/phpunit": "^12.5|^13.0",
        "symfony/finder": "^8.1",
        "symfony/string": "^8.1",
        "symplify/phpstan-extensions": "^12.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "policy": {
            "cooldown": {
                "period": "1 day",
                "ignore": [
                    "eonx-com/*"
                ]
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "extra": {
        "eonx_docs": {
            "ignore": true
        }
    }
}
