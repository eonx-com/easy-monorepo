{
    "name": "eonx-com/easy-request-response-logging",
    "description": "Logging of incoming HTTP requests and responses with sanitized data",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "eonx-com/easy-request-id": "^6.27",
        "eonx-com/easy-utils": "^6.27",
        "psr/log": "^3.0",
        "symfony/config": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/event-dispatcher": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/http-kernel": "^7.2"
    },
    "require-dev": {
        "eonx-com/easy-logging": "^6.27",
        "eonx-com/easy-test": "^6.27",
        "laravel/lumen-framework": "^11.0",
        "phpunit/phpunit": "^10.5.63|^11.5.50|^12.5.8",
        "symfony/framework-bundle": "^7.2",
        "symfony/monolog-bundle": "^3.11.1"
    },
    "autoload": {
        "psr-4": {
            "EonX\\EasyRequestResponseLogging\\": "src",
            "EonX\\EasyRequestResponseLogging\\Bundle\\": "bundle",
            "EonX\\EasyRequestResponseLogging\\Laravel\\": "laravel"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EonX\\EasyRequestResponseLogging\\Tests\\": "tests",
            "EonX\\EasyRequestResponseLogging\\Tests\\Application\\": "tests/Application/src",
            "EonX\\EasyRequestResponseLogging\\Tests\\Application\\Bundle\\": "tests/Application/bundle",
            "EonX\\EasyRequestResponseLogging\\Tests\\Fixture\\App\\": "tests/Fixture/app/src",
            "EonX\\EasyRequestResponseLogging\\Tests\\Unit\\Laravel\\": "tests/Unit/laravel"
        }
    },
    "suggest": {
        "eonx-com/easy-logging": "To use EasyLogging LoggerFactory for the log channel",
        "illuminate/http": "To use this package with Laravel/Lumen",
        "illuminate/support": "To use this package with Laravel/Lumen",
        "laravel/lumen-framework": "To use this package with Lumen",
        "symfony/monolog-bundle": "To use Symfony MonologBundle for the log channel"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.27-dev"
        }
    }
}
